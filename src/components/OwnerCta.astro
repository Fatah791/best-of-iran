---
import Icon from './Icon.astro';
import { ownerCta } from '../data/site';
---

<section class="py-12 px-margin-mobile md:px-margin-desktop">
  <div
    class="max-w-screen-2xl mx-auto w-full bg-gradient-to-l from-surface-container-high to-surface-container rounded-3xl border border-outline-variant/30 overflow-hidden relative"
  >
    <!-- Abstract decoration -->
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>

    <div
      class="relative z-10 p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8"
    >
      <div class="text-center md:text-right flex-grow">
        <h2 class="font-headline-xl text-2xl md:text-3xl text-on-surface mb-3">
          {ownerCta.title}
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
          {ownerCta.body}
        </p>
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mt-6">
          {
            ownerCta.benefits.map((benefit) => (
              <div class="flex items-center gap-1 text-sm text-on-surface-variant">
                <Icon class="text-tertiary-fixed text-sm" icon="check_circle" />
                {benefit}
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex-shrink-0">
        <a
          class="bg-primary text-on-primary px-8 py-4 rounded-xl font-headline-md text-base hover:brightness-110 transition-all shadow-lg shadow-primary/20 flex items-center gap-2"
          href="/register"
        >
          {ownerCta.button}
          <Icon icon="add_business" />
        </a>
      </div>
    </div>
  </div>
</section>
