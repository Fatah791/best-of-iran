---
import Icon from './Icon.astro';
import type { Article } from '../data/content';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article
  class="bg-surface-container rounded-2xl overflow-hidden border border-surface-variant hover:border-outline-variant transition-colors flex flex-col"
>
  <div class="h-48 bg-surface-container-high relative overflow-hidden">
    <div class="absolute inset-0 bg-surface-variant animate-pulse" role="img" aria-label={`تصویر مقاله: ${article.title}`}></div>
    <div class="absolute top-4 right-4 flex gap-2">
      <span class="bg-primary text-on-primary px-2 py-1 rounded-md text-xs font-bold">
        {article.category}
      </span>
      <span class="bg-surface/80 backdrop-blur-sm text-on-surface px-2 py-1 rounded-md text-xs">
        {article.city}
      </span>
    </div>
  </div>

  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-2 mb-3 text-on-surface-variant">
      <Icon class="text-sm" icon="calendar_month" />
      <span class="text-xs font-label-sm">{article.date}</span>
    </div>

    <h3 class="font-headline-md text-lg text-on-surface mb-3 line-clamp-2 group-hover:text-primary transition-colors">
      <a href={`/articles/${article.slug}`}>{article.title}</a>
    </h3>

    <p class="text-on-surface-variant text-sm line-clamp-3 mb-4 flex-grow">
      {article.excerpt}
    </p>

    <a
      class="text-primary font-label-md flex items-center gap-1 mt-auto hover:underline w-fit"
      href={`/articles/${article.slug}`}
    >
      ادامه مطلب
      <Icon class="text-sm" icon="arrow_back" />
    </a>
  </div>
</article>
