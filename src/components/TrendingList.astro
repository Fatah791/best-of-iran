---
import Icon from './Icon.astro';
import { topTrending, fa, faRating, type Business } from '../data/businesses';
import { categories, cities } from '../data/site';

/** Homepage "trending this week" — real data from the directory. */
const list: Business[] = topTrending(3);
const catOf = (b: Business) => categories.find((c) => c.slug === b.category);
const cityOf = (b: Business) => cities.find((c) => c.slug === b.city);
---

<section class="py-16 bg-surface-container-low px-margin-mobile md:px-margin-desktop">
  <div class="max-w-screen-2xl mx-auto w-full">
    <div class="flex items-center gap-3 mb-8">
      <Icon class="text-3xl text-tertiary-fixed" icon="trending_up" />
      <div>
        <h2 class="font-headline-md text-headline-md text-on-surface">
          پربازدیدترین‌های هفته
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          کسب‌وکارهایی که بیشترین تماس و رزرو را داشته‌اند.
        </p>
      </div>
    </div>

    <div class="bg-surface rounded-2xl border border-surface-variant overflow-hidden">
      <div class="divide-y divide-surface-variant">
        {
          list.map((business, i) => {
            const cat = catOf(business);
            const city = cityOf(business);
            return (
              <div class="p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 hover:bg-surface-container-lowest transition-colors" data-reveal="">
                <div
                  class:list={[
                    'flex-shrink-0 w-12 h-12 rounded-full bg-surface-container flex items-center justify-center font-bold text-lg',
                    i === 0 ? 'text-primary' : 'text-on-surface-variant',
                  ]}
                >
                  {fa(i + 1)}
                </div>
                <div class="flex-grow">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-headline-md text-lg text-on-surface">
                      <a class="hover:text-primary transition-colors" href={`/business/${business.slug}`}>
                        {business.name}
                      </a>
                    </h3>
                    {business.verified && (
                      <Icon class="text-tertiary-fixed text-sm" icon="verified" title="تایید شده" />
                    )}
                  </div>
                  <div class="flex flex-wrap items-center gap-3 text-sm text-on-surface-variant">
                    <span class="flex items-center gap-1">
                      <Icon class="text-sm" icon={cat?.icon ?? 'category'} />
                      {cat?.label}
                    </span>
                    <span class="flex items-center gap-1">
                      <Icon class="text-sm" icon="location_on" />
                      {city?.label}{business.neighborhood ? `، ${business.neighborhood}` : ''}
                    </span>
                    <span class="flex items-center gap-1 text-primary">
                      <Icon class="text-sm" icon="starFilled" />
                      {faRating(business.rating)} ({fa(business.reviews)} نظر)
                    </span>
                  </div>
                </div>

                {
                  business.phone ? (
                    <a
                      class="w-full sm:w-auto mt-3 sm:mt-0 px-6 py-2 bg-primary-container text-on-primary-container rounded-lg font-label-md flex items-center justify-center gap-2 hover:brightness-110"
                      href={`tel:${business.phone}`}
                    >
                      <Icon class="text-sm" icon="call" />
                      تماس
                    </a>
                  ) : (
                    <a
                      class="w-full sm:w-auto mt-3 sm:mt-0 px-6 py-2 border border-outline-variant text-on-surface rounded-lg font-label-md flex items-center justify-center gap-2 hover:bg-surface-container"
                      href={`/business/${business.slug}`}
                    >
                      <Icon class="text-sm" icon="visibility" />
                      مشاهده
                    </a>
                  )
                }
              </div>
            );
          })
        }
      </div>
      <div class="p-4 bg-surface-container-lowest text-center border-t border-surface-variant">
        <a class="text-primary font-label-md hover:underline" href="/trending">
          مشاهده لیست کامل پربازدیدها
        </a>
      </div>
    </div>
  </div>
</section>
