---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { allCategories } from '../lib/wp-adapter';

const categories = (await allCategories()).slice(0, 7);
---

<section class="py-16 bg-surface-container-low px-margin-mobile md:px-margin-desktop">
  <div class="max-w-screen-2xl mx-auto w-full">
    <SectionHeading subtitle="در میان محبوب‌ترین خدمات جستجو کنید." title="دسته‌بندی‌های پرطرفدار" />

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4">
      {
        categories.map((category) => (
          <a
            class="flex flex-col items-center justify-center p-6 bg-surface rounded-xl border border-surface-variant hover:border-primary/50 hover:bg-surface-container transition-all group"
            href={`/categories/${category.slug}`}
          >
            <div class="w-16 h-16 rounded-full bg-primary-container/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <Icon class="text-3xl text-primary" icon={category.icon} />
            </div>
            <span class="font-label-md text-label-md text-on-surface">
              {category.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
