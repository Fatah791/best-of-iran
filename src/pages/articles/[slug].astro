---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleBlocks from '../../components/ArticleBlocks.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getAllArticles, type FullArticle } from '../../data/articles';
import { site } from '../../data/site';
import { breadcrumbLd, faqLd } from '../../lib/schema';

export function getStaticPaths() {
  return getAllArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: FullArticle };
const url = new URL(Astro.url.pathname, Astro.site).href;

const faqBlock = article.blocks.find((b) => b.type === 'faq');
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    inLanguage: 'fa',
    author: { '@type': 'Organization', name: article.author },
    publisher: { '@type': 'Organization', name: site.name },
    datePublished: article.isoDate,
    dateModified: article.isoDate,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '#quick-answer h2 + ul li:first-child'],
    },
  },
  breadcrumbLd([
    { label: 'مقالات', href: '/articles' },
    ...article.breadcrumb.slice(1).map((c) => ({
      label: c.label,
      href: c.href === '#' ? undefined : c.href,
    })),
  ]),
  ...(faqBlock?.type === 'faq' ? [faqLd(faqBlock.items)] : []),
];
---

<BaseLayout description={article.description} title={article.title}>
  <JsonLd data={ld} slot="head" />
  <ArticleLayout article={article}>
    {article.blocks.map((block) => <ArticleBlocks block={block} />)}
  </ArticleLayout>
</BaseLayout>
