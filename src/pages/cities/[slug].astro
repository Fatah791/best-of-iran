---
import PageLayout from '../../layouts/PageLayout.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { citySeo } from '../../data/seo';
import { breadcrumbLd, itemListLd, faqLd } from '../../lib/schema';
import { allCities, allCategories, byCity } from '../../lib/wp-adapter';
import { fa } from '../../data/businesses';

export async function getStaticPaths() {
  const cities = await allCities();
  return cities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const [list, categories] = [await byCity(city.slug), await allCategories()];
const seo = citySeo[city.slug] ?? { intro: '', faq: [] };
const catsWithItems = categories.filter((c) => list.some((b) => b.category === c.slug));

const ld = [
  breadcrumbLd([{ label: 'شهرها', href: '/cities' }, { label: city.label }]),
  ...(list.length
    ? [itemListLd(`بهترین کسب‌وکارهای ${city.label}`, list.map((b) => ({ name: b.name, url: `/business/${b.slug}` })))]
    : []),
  ...(seo.faq.length ? [faqLd(seo.faq)] : []),
];
---

<PageLayout
  description={`بهترین کسب‌وکارهای ${city.label} — بررسی میدانی و رتبه‌بندی بست آف ایران.`}
  heading={`بهترین‌های ${city.label}`}
  subheading={list.length ? `${fa(list.length)} کسب‌وکار برتر ${city.label} که تیم ما میدانی بررسی کرده است.` : 'فهرست کسب‌وکارهای این شهر در حال تکمیل است.'}
  title={`شهر ${city.label}`}
>
  <JsonLd data={ld} slot="head" />

  <Breadcrumbs slot="breadcrumbs" crumbs={[{ label: 'شهرها', href: '/cities' }, { label: city.label }]} />

  <div slot="actions">
    <nav class="flex flex-wrap gap-2 mt-2" aria-label="دسته‌بندی‌های این شهر">
      {
        catsWithItems.map((c) => (
          <a
            class="px-4 py-2 rounded-full border border-outline-variant text-on-surface-variant hover:text-primary hover:border-primary font-label-md text-label-md transition-colors"
            href={`/categories/${c.slug}?city=${city.slug}`}
          >
            {c.label}
            <Icon class="text-xs mr-1 inline-block" icon="arrow_back" />
          </a>
        ))
      }
    </nav>
  </div>

  {
    seo.intro && (
      <div class="mb-lg max-w-3xl">
        <p class="text-on-surface-variant leading-relaxed text-body-md">{seo.intro}</p>
      </div>
    )
  }

  <div class="space-y-md" id="all">
    {
      list.length > 0 ? (
        list.map((b) => <PlaceCard business={b} compact />)
      ) : (
        <div class="bg-surface-container rounded-2xl border border-dashed border-outline-variant p-lg text-center">
          <Icon class="text-4xl text-outline mx-auto mb-3" icon="search" />
          <h2 class="font-headline-md text-lg text-on-surface mb-2">
            هنوز بررسی‌ها در این شهر آغاز نشده
          </h2>
          <p class="text-on-surface-variant text-sm mb-6">
            فهرست کسب‌وکارهای {city.label} در حال تکمیل است. اگر صاحب کسب‌وکاری،
            همین حالا درخواست بررسی بده.
          </p>
          <a
            class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-xl font-label-md hover:brightness-110 transition-all"
            href="/register"
          >
            <Icon icon="add_business" />
            ثبت کسب‌وکار در {city.label}
          </a>
        </div>
      )
    }
  </div>

  {
    seo.faq.length > 0 && (
      <section class="mt-xl max-w-3xl">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-md">
          سوالات متداول درباره {city.label}
        </h2>
        <div class="space-y-sm">
          {seo.faq.map((item) => (
            <details class="group bg-surface border border-outline-variant rounded-lg [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 text-on-surface font-medium">
                {item.q}
                <Icon class="shrink-0 transition duration-300 group-open:-rotate-180" icon="expand_more" />
              </summary>
              <div class="border-t border-outline-variant px-4 py-3 text-sm text-on-surface-variant">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }
</PageLayout>
