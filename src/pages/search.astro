---
import PageLayout from '../layouts/PageLayout.astro';
import PlaceCard from '../components/PlaceCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { allCities, allCategories, allBusinesses } from '../lib/wp-adapter';

const [cities, categories, businesses] = [await allCities(), await allCategories(), await allBusinesses()];

const q = Astro.url.searchParams.get('q') ?? '';
const city = Astro.url.searchParams.get('city') ?? '';
const category = Astro.url.searchParams.get('category') ?? '';

const initial = businesses.filter((b) => {
  if (city && b.city !== city) return false;
  if (category && b.category !== category) return false;
  return true;
});
---

<PageLayout
  description={`جستجو در ${site.nameFa}: نام کسب‌وکار، شهر یا دسته‌بندی را وارد کنید.`}
  heading="جستجوی کسب‌وکارها"
  subheading="نام، محله یا دسته‌بندی را بنویسید؛ نتیجه‌ها همان لحظه فیلتر می‌شوند."
  title="جستجو"
>
  <!-- Search controls -->
  <div
    class="bg-surface-container rounded-2xl border border-surface-variant p-md grid grid-cols-1 md:grid-cols-4 gap-sm items-end mb-lg"
    id="search-controls"
  >
    <div class="md:col-span-2">
      <label class="block font-label-md text-label-md text-on-surface-variant mb-2" for="search-q">
        نام یا کلیدواژه
      </label>
      <div class="flex items-center bg-surface rounded-lg px-sm border border-outline-variant focus-within:border-primary-container transition-colors">
        <Icon class="text-on-surface-variant ml-xs text-lg" icon="search" />
        <input
          class="w-full bg-transparent border-none outline-none text-body-md text-on-surface py-3"
          id="search-q"
          name="q"
          placeholder="مثال: کارواش، عباسی، نانو..."
          type="search"
          value={q}
        />
      </div>
    </div>
    <div>
      <label class="block font-label-md text-label-md text-on-surface-variant mb-2" for="search-city">شهر</label>
      <select class="w-full bg-surface rounded-lg px-sm py-3 border border-outline-variant text-body-md text-on-surface outline-none focus:border-primary-container" id="search-city">
        <option value="">همه شهرها</option>
        {cities.map((c) => <option selected={c.slug === city} value={c.slug}>{c.label}</option>)}
      </select>
    </div>
    <div>
      <label class="block font-label-md text-label-md text-on-surface-variant mb-2" for="search-cat">دسته‌بندی</label>
      <select class="w-full bg-surface rounded-lg px-sm py-3 border border-outline-variant text-body-md text-on-surface outline-none focus:border-primary-container" id="search-cat">
        <option value="">همه دسته‌ها</option>
        {categories.map((c) => <option selected={c.slug === category} value={c.slug}>{c.label}</option>)}
      </select>
    </div>
  </div>

  <p class="text-sm text-on-surface-variant mb-md" id="search-count" role="status">
    {initial.length} نتیجه
  </p>

  <div class="space-y-md" id="search-results">
    {
      initial.map((b) => (
        <div data-search-item data-city={b.city} data-category={b.category} data-text={`${b.name} ${b.tagline} ${b.address} ${b.tags.join(' ')} ${b.neighborhood ?? ''}`}>
          <PlaceCard business={b} />
        </div>
      ))
    }
  </div>

  <div class="hidden text-center py-xl" id="search-empty">
    <Icon class="text-4xl text-outline mx-auto mb-3" icon="search_off" />
    <h3 class="font-headline-md text-lg text-on-surface mb-2">موردی پیدا نشد</h3>
    <p class="text-on-surface-variant text-sm mb-6">کلیدواژه دیگری امتحان کنید یا فیلترها را بردارید.</p>
    <button class="text-primary font-label-md underline" id="search-reset" type="button">پاک کردن فیلترها</button>
  </div>
</PageLayout>

<script>
  // Client-side live filtering over pre-rendered cards (small dataset —
  // no server needed). Rebuilds nothing; just toggles hidden + count.
  const items = [...document.querySelectorAll<HTMLElement>('[data-search-item]')];
  const q = document.querySelector<HTMLInputElement>('#search-q')!;
  const city = document.querySelector<HTMLSelectElement>('#search-city')!;
  const cat = document.querySelector<HTMLSelectElement>('#search-cat')!;
  const count = document.querySelector('#search-count')!;
  const empty = document.querySelector('#search-empty')!;
  const results = document.querySelector('#search-results')!;

  const faDigits = (n: number) => String(n).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);

  function apply() {
    const query = q.value.trim().toLowerCase();
    let visible = 0;
    for (const el of items) {
      const ok =
        (!city.value || el.dataset.city === city.value) &&
        (!cat.value || el.dataset.category === cat.value) &&
        (!query ||
          (el.dataset.text ?? '').toLowerCase().includes(query) ||
          el.querySelector('h3')?.textContent?.toLowerCase().includes(query));
      el.classList.toggle('hidden', !ok);
      if (ok) visible++;
    }
    count.textContent = `${faDigits(visible)} نتیجه`;
    empty.classList.toggle('hidden', visible !== 0);
    results.classList.toggle('hidden', visible === 0);
  }

  document.querySelector('#search-reset')?.addEventListener('click', () => {
    q.value = '';
    city.value = '';
    cat.value = '';
    apply();
  });

  q.addEventListener('input', apply);
  city.addEventListener('change', apply);
  cat.addEventListener('change', apply);
</script>
