---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNavBar from '../../components/TopNavBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { allGuides } from '../../lib/wp-adapter';
import type { Guide } from '../../lib/wp-adapter';
import { site } from '../../data/site';
import { breadcrumbLd } from '../../lib/schema';

export async function getStaticPaths() {
  const guides = await allGuides();
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const url = new URL(Astro.url.pathname, Astro.site).href;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    inLanguage: 'fa',
    author: { '@type': 'Organization', name: guide.author },
    publisher: { '@type': 'Organization', name: site.name },
    datePublished: guide.isoDate,
    dateModified: guide.isoDate,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  breadcrumbLd([
    { label: 'راهنماها', href: '/guides' },
    { label: guide.title },
  ]),
];
---

<BaseLayout description={guide.description} title={guide.title}>
  <JsonLd data={ld} slot="head" />

  <div class="premium-bg min-h-screen flex flex-col">
    <TopNavBar />

    <div class="max-w-screen-xl mx-auto px-margin-mobile md:px-margin-desktop py-lg flex flex-col md:flex-row gap-gutter relative w-full">
      <!-- TOC Sidebar (Desktop) -->
      <aside class="hidden md:block w-64 shrink-0">
        {guide.toc.length > 1 && (
          <div class="sticky top-[100px] bg-surface rounded-xl p-md border border-outline-variant">
            <h2 class="font-bold text-lg mb-sm text-on-surface">فهرست مطالب</h2>
            <nav class="flex flex-col space-y-3 text-sm text-on-surface-variant">
              {guide.toc.map((item) => (
                <a
                  class:list={['toc-link pr-2 hover:text-primary', { 'pr-6 text-xs': item.level === 3 }]}
                  href={`#${item.id}`}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        )}
      </aside>

      <main class="flex-1 w-full min-w-0" id="main" tabindex="-1">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="text-on-surface-variant text-xs font-medium mb-md">
          <ol class="flex flex-wrap items-center gap-1">
            <li><a class="hover:text-primary transition-colors" href="/">خانه</a></li>
            <li class="flex items-center">
              <Icon class="mx-1 text-xs" icon="chevron_left" />
              <a class="hover:text-primary transition-colors" href="/guides">راهنماها</a>
            </li>
            <li class="flex items-center">
              <Icon class="mx-1 text-xs" icon="chevron_left" />
              <span class="text-on-surface">{guide.title}</span>
            </li>
          </ol>
        </nav>

        <!-- Header -->
        <header class="mb-xl">
          <h1 class="text-3xl md:text-4xl font-bold text-primary mb-sm leading-tight">{guide.title}</h1>
          <div class="flex flex-wrap items-center gap-md text-on-surface-variant text-sm font-medium">
            <span class="flex items-center gap-xs">
              <Icon class="text-sm" icon="calendar_today" />
              به‌روزرسانی: {guide.updated}
            </span>
            <span class="flex items-center gap-xs">
              <Icon class="text-sm" icon="person" />
              {guide.author}
            </span>
            <span class="flex items-center gap-xs">
              <Icon class="text-sm" icon="timer" />
              زمان مطالعه: {guide.readTime}
            </span>
          </div>
        </header>

        {guide.image && (
          <div class="rounded-2xl overflow-hidden border border-outline-variant mb-xl">
            <img src={guide.image} alt={guide.title} class="w-full max-h-96 object-cover" loading="eager" />
          </div>
        )}

        <!-- Prose body -->
        <article class="guide-prose" set:html={guide.html} />
      </main>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>

<style is:global>
  .premium-bg {
    --color-background: #0d0d0f;
    --color-surface: #1a1a1e;
    --color-primary: #f5b841;

    background-color: #0d0d0f;
    background-image:
      radial-gradient(circle at 15% 50%, #161618, transparent 60%),
      radial-gradient(circle at 85% 20%, #161618, transparent 60%),
      radial-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 24px 24px;
    background-attachment: fixed;
  }
  .toc-link.active {
    color: #f5b841;
    font-weight: 700;
    border-right: 2px solid #f5b841;
  }

  /* Prose styling for WP-rendered guide bodies — same palette as articles. */
  .guide-prose { color: var(--color-on-surface-variant, #b8b8bf); line-height: 2; max-width: none; }
  .guide-prose h2 { font-size: 1.5rem; font-weight: 800; color: #f5b841; margin: 2.5rem 0 1rem; }
  .guide-prose h3 { font-size: 1.2rem; font-weight: 700; color: #e6e6ea; margin: 2rem 0 0.75rem; }
  .guide-prose p { margin: 0 0 1.25rem; }
  .guide-prose ul, .guide-prose ol { margin: 0 0 1.25rem; padding-right: 1.5rem; }
  .guide-prose ul { list-style: disc; }
  .guide-prose ol { list-style: decimal; }
  .guide-prose li { margin-bottom: 0.5rem; }
  .guide-prose a { color: #f5b841; text-decoration: underline; }
  .guide-prose strong { color: #e6e6ea; }
  .guide-prose img { border-radius: 1rem; margin: 1.5rem auto; max-width: 100%; height: auto; }
  .guide-prose blockquote { border-right: 3px solid #f5b841; padding: 0.5rem 1rem; margin: 1.5rem 0; background: #1a1a1e; border-radius: 0 0.75rem 0.75rem 0; font-style: normal; }
  .guide-prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  .guide-prose th, .guide-prose td { border: 1px solid #2a2a30; padding: 0.6rem 0.8rem; text-align: right; }
  .guide-prose th { background: #1a1a1e; color: #e6e6ea; }
</style>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')].map((a) => [
      a.getAttribute('href')!.slice(1),
      a,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(entry.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>
